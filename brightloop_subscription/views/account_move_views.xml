<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account Move Form View Inherit -->
    <record id="view_move_form_subscription" model="ir.ui.view">
        <field name="name">account.move.form.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="subscription_id" readonly="1" invisible="not subscription_id"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Tree View Inherit -->
    <record id="view_invoice_tree_subscription" model="ir.ui.view">
        <field name="name">account.invoice.tree.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="subscription_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Account Move Search View Inherit -->
    <record id="view_account_invoice_filter_subscription" model="ir.ui.view">
        <field name="name">account.invoice.select.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myinvoices']" position="after">
                <filter string="Subscription Invoices" name="filter_subscription_invoices" domain="[('subscription_id', '!=', False)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Subscription" name="group_by_subscription" context="{'group_by': 'subscription_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
