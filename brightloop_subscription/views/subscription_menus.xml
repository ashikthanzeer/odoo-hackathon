<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level Menu -->
    <menuitem id="menu_brightloop_subscription_root"
              name="Subscriptions"
              web_icon="brightloop_subscription,static/description/icon.png"
              sequence="20"
              groups="group_subscription_user,group_subscription_manager"/>

    <!-- Operational Menus -->
    <menuitem id="menu_brightloop_subscription_operations"
              name="Operations"
              parent="menu_brightloop_subscription_root"
              sequence="10"/>

    <menuitem id="menu_brightloop_subscription_customers"
              name="Customers"
              parent="menu_brightloop_subscription_operations"
              action="base.action_partner_form"
              sequence="10"/>

    <!-- Catalog Menus -->
    <menuitem id="menu_brightloop_subscription_catalog"
              name="Catalog"
              parent="menu_brightloop_subscription_root"
              sequence="20"/>

    <!-- Reporting Menus -->
    <menuitem id="menu_brightloop_subscription_reporting"
              name="Reporting"
              parent="menu_brightloop_subscription_root"
              sequence="50"
              groups="group_subscription_user,group_subscription_manager"/>

    <menuitem id="menu_subscription_analytics"
              name="Subscription Analytics"
              parent="menu_brightloop_subscription_reporting"
              action="action_subscription_report_all"
              sequence="10"/>

    <!-- Configuration Menu (Administrators Only) -->
    <menuitem id="menu_brightloop_subscription_config"
              name="Configuration"
              parent="menu_brightloop_subscription_root"
              sequence="100"
              groups="group_subscription_manager"/>
</odoo>
