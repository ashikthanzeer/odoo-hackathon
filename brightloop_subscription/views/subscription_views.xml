<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Tree View -->
    <record id="view_subscription_tree" model="ir.ui.view">
        <field name="name">subscription.subscription.tree</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-info="state == 'draft'"
                  decoration-primary="state == 'quotation'"
                  decoration-warning="state == 'confirmed'"
                  decoration-success="state == 'active'"
                  decoration-danger="state == 'paused'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="next_billing_date" optional="show"/>
                <field name="expiry_date" optional="hide"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_net" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="mrr" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="arr" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide"/>
                <field name="paid_amount" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="amount_due" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="discount_rule_id" optional="hide"/>
                <field name="currency_id" invisible="1"/>
                <field name="payment_status" widget="badge"
                       decoration-info="payment_status == 'draft'"
                       decoration-warning="payment_status in ('pending', 'partial')"
                       decoration-success="payment_status == 'paid'"
                       decoration-danger="payment_status == 'overdue'"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'quotation'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'paused'"
                       decoration-muted="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_quote" string="Mark as Quotation" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm &amp; Activate" type="object" class="oe_highlight" invisible="state not in ('draft', 'quotation')"/>
                    <button name="action_generate_invoice" string="Generate Invoice" type="object" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_renew" string="Renew Subscription" type="object" class="btn-success" invisible="state not in ('active', 'paused', 'closed')"/>
                    <button name="action_pause" string="Pause Subscription" type="object" class="btn-warning" invisible="state != 'active'"/>
                    <button name="action_resume" string="Resume Subscription" type="object" class="btn-success" invisible="state != 'paused'"/>
                    <button name="action_close" string="Close Subscription" type="object" class="btn-secondary" invisible="state not in ('active', 'paused')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_invoices" icon="fa-pencil-square-o">
                            <field string="Invoices" name="invoice_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_payments" icon="fa-money">
                            <field string="Payments" name="payment_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Subscription Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div class="o_row">
                            <field name="payment_status" widget="badge"
                                   decoration-info="payment_status == 'draft'"
                                   decoration-warning="payment_status in ('pending', 'partial')"
                                   decoration-success="payment_status == 'paid'"
                                   decoration-danger="payment_status == 'overdue'"/>
                        </div>
                    </div>
                    <group>
                        <group string="Customer &amp; Plan">
                            <field name="partner_id" widget="res_partner_many2one"/>
                            <field name="plan_id"/>
                            <field name="template_id"/>
                            <field name="discount_rule_id" options="{'no_create': True}"/>
                            <field name="payment_term_id"/>
                        </group>
                        <group string="Contract &amp; Billing Schedule">
                            <field name="start_date"/>
                            <field name="next_billing_date"/>
                            <field name="last_billing_date"/>
                            <field name="expiry_date"/>
                            <field name="mrr" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="arr" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="paid_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_due" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subscription Lines" name="lines_page">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group col="6" class="mt-2 mt-md-0">
                                <group colspan="4">
                                    <field name="notes" placeholder="Custom terms and contract notes..."/>
                                </group>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="subscription_total">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total"/>
                                    <field name="discount_amount" invisible="discount_amount == 0"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="amount_net"/>
                                    </div>
                                    <field name="amount_net" nolabel="1" class="oe_subtotal_footer_separator"/>
                                </group>
                                <div class="oe_clear"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subscription Kanban View -->
    <record id="view_subscription_kanban" model="ir.ui.view">
        <field name="name">subscription.subscription.kanban</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="payment_status"/>
                <field name="start_date"/>
                <field name="next_billing_date"/>
                <field name="expiry_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3 mb-2 rounded shadow-sm border">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted"><field name="partner_id"/></div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><span class="badge bg-light text-dark border"><field name="plan_id"/></span></div>
                                <div class="mt-2 text-muted small">
                                    <span>Next Bill: <field name="next_billing_date"/></span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                <strong class="text-primary fs-6">
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </strong>
                                <div>
                                    <span class="badge me-1" t-attf-class="badge-#{record.payment_status.raw_value}">
                                        <field name="payment_status"/>
                                    </span>
                                    <span class="badge" t-attf-class="badge-#{record.state.raw_value}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Subscription Search View -->
    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">subscription.subscription.search</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="discount_rule_id"/>
                <field name="payment_status"/>
                <filter string="Quotations" name="filter_quotations" domain="[('state', 'in', ('draft', 'quotation'))]"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Discounted" name="filter_discounted" domain="[('discount_rule_id', '!=', False)]"/>
                <filter string="Billing Due" name="filter_billing_due" domain="[('state', '=', 'active'), ('next_billing_date', '&lt;=', context_today())]"/>
                <filter string="Paused" name="filter_paused" domain="[('state', '=', 'paused')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Paid" name="filter_paid" domain="[('payment_status', '=', 'paid')]"/>
                <filter string="Pending Payment" name="filter_pending" domain="[('payment_status', '=', 'pending')]"/>
                <filter string="Payment Overdue" name="filter_overdue" domain="[('payment_status', '=', 'overdue')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Payment Status" name="group_by_payment_status" context="{'group_by': 'payment_status'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Plan" name="group_by_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Next Billing Date" name="group_by_next_billing" context="{'group_by': 'next_billing_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions for Subscriptions -->
    <record id="action_subscription_all" model="ir.actions.act_window">
        <field name="name">Subscriptions &amp; Quotations</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_subscription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Subscription or Quotation!
            </p>
            <p>
                Draft offers, pick quotation templates, and activate subscriptions seamlessly.
            </p>
        </field>
    </record>

    <record id="action_subscription_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_subscription_search"/>
        <field name="domain">[('state', 'in', ('draft', 'quotation'))]</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_subscription_all"
              name="All Subscriptions"
              parent="menu_brightloop_subscription_operations"
              action="action_subscription_all"
              sequence="1"/>

    <menuitem id="menu_subscription_quotes"
              name="Quotations"
              parent="menu_brightloop_subscription_operations"
              action="action_subscription_quotations"
              sequence="2"/>
</odoo>
