<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form View Inherit -->
    <record id="view_partner_form_subscription" model="ir.ui.view">
        <field name="name">res.partner.form.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_partner_invoices"
                        icon="fa-refresh" invisible="not is_subscription_customer">
                    <field string="Subscriptions" name="subscription_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Subscription Details" name="subscription_details">
                    <group>
                        <group string="Profile">
                            <field name="is_subscription_customer"/>
                        </group>
                        <group string="Instructions &amp; Notes">
                            <field name="subscription_notes" placeholder="Special billing instructions, portal preferences..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Partner Search View Inherit -->
    <record id="view_res_partner_filter_subscription" model="ir.ui.view">
        <field name="name">res.partner.select.subscription</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <filter string="Subscription Customers" name="filter_subscription_customer" domain="[('is_subscription_customer', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
