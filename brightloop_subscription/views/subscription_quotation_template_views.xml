<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Template Tree View -->
    <record id="view_subscription_quotation_template_tree" model="ir.ui.view">
        <field name="name">subscription.quotation.template.tree</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <list string="Quotation Templates">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Quotation Template Form View -->
    <record id="view_subscription_quotation_template_form" model="ir.ui.view">
        <field name="name">subscription.quotation.template.form</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Standard SaaS Offer, Enterprise Bundle"/>
                        </h1>
                        <field name="active" invisible="1"/>
                    </div>
                    <group>
                        <group string="Offer Settings">
                            <field name="plan_id"/>
                            <label for="validity_days" string="Validity"/>
                            <div class="o_row">
                                <field name="validity_days" class="oe_inline"/>
                                <span class="text-muted">days from quote creation</span>
                            </div>
                        </group>
                        <group string="Organization">
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pre-configured Lines" name="lines_page">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Terms &amp; Notes" name="description_page">
                            <field name="description" placeholder="Standard offer terms, payment expectations, renewal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quotation Template Action -->
    <record id="action_subscription_quotation_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">subscription.quotation.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Subscription Quotation Template!
            </p>
            <p>
                Templates help sales reps generate pre-filled quotes with the right plan and products in seconds.
            </p>
        </field>
    </record>

    <!-- Menu Item for Quotation Templates -->
    <menuitem id="menu_subscription_quotation_template"
              name="Quotation Templates"
              parent="menu_brightloop_subscription_config"
              action="action_subscription_quotation_template"
              sequence="20"/>
</odoo>
