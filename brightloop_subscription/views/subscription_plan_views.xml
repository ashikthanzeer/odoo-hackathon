<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Plan Tree View -->
    <record id="view_subscription_plan_tree" model="ir.ui.view">
        <field name="name">subscription.plan.tree</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="billing_cycle_unit"/>
                <field name="billing_interval"/>
                <field name="min_quantity"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="auto_close_on_end"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Subscription Plan Form View -->
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Plan Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Pro Monthly, Enterprise Yearly"/>
                        </h1>
                        <div class="o_row">
                            <label for="code" string="Plan Code:"/>
                            <field name="code" placeholder="e.g. PRO-M" class="oe_inline"/>
                            <field name="active" invisible="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Billing Cycle">
                            <field name="billing_cycle_unit"/>
                            <label for="billing_interval" string="Every"/>
                            <div class="o_row">
                                <field name="billing_interval" class="oe_inline"/>
                                <span class="text-muted">cycle period(s)</span>
                            </div>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity &amp; Constraints">
                            <field name="min_quantity"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <group string="Lifecycle Behavioral Policies">
                        <group>
                            <field name="auto_close_on_end" widget="boolean_toggle"/>
                            <field name="allow_close_early" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="allow_pause" widget="boolean_toggle"/>
                            <field name="allow_renewal" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Description" name="description_page">
                            <field name="description" placeholder="Public plan terms, included quotas, SLAs..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subscription Plan Search View -->
    <record id="view_subscription_plan_search" model="ir.ui.view">
        <field name="name">subscription.plan.search</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <search string="Search Plans">
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Daily" name="filter_daily" domain="[('billing_cycle_unit', '=', 'daily')]"/>
                <filter string="Weekly" name="filter_weekly" domain="[('billing_cycle_unit', '=', 'weekly')]"/>
                <filter string="Monthly" name="filter_monthly" domain="[('billing_cycle_unit', '=', 'monthly')]"/>
                <filter string="Yearly" name="filter_yearly" domain="[('billing_cycle_unit', '=', 'yearly')]"/>
                <group>
                    <filter string="Billing Unit" name="group_by_unit" context="{'group_by': 'billing_cycle_unit'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Subscription Plans -->
    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_plan_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Brightloop Subscription Plan!
            </p>
            <p>
                Configure billing recurrence (daily, weekly, monthly, yearly), minimum quantities, validity dates, and lifecycle rules.
            </p>
        </field>
    </record>

    <!-- Menu Items for Subscription Plans -->
    <menuitem id="menu_subscription_plan"
              name="Subscription Plans"
              parent="menu_brightloop_subscription_config"
              action="action_subscription_plan"
              sequence="10"/>

    <menuitem id="menu_catalog_subscription_plan"
              name="Subscription Plans"
              parent="menu_brightloop_subscription_catalog"
              action="action_subscription_plan"
              sequence="10"/>
</odoo>
